    {
      "name": "Restaurant",
      "description": "FosRestaurant HTTP API. There are no GET routes, so each write returns the full item.\n\nCreating or updating a product publishes a `ProductChanged` event (fos.restaurant) to the bus, which routes it to the OrderEvents queue.",
      "item": [
        {
          "name": "Create restaurant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('OPEN by default', () => pm.expect(body.status).to.eql('OPEN'));",
                  "pm.collectionVariables.set('restaurantId', body.restaurantId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{restaurantUrl}}/restaurants",
              "host": [
                "{{restaurantUrl}}"
              ],
              "path": [
                "restaurants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pasta Place\"\n}"
            },
            "description": "Creates a restaurant (status defaults to OPEN) and saves `restaurantId`."
          }
        },
        {
          "name": "Close restaurant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('now CLOSED', () => pm.expect(pm.response.json().status).to.eql('CLOSED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{restaurantUrl}}/restaurants/{{restaurantId}}",
              "host": [
                "{{restaurantUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLOSED\"\n}"
            },
            "description": "While CLOSED, ConfirmOrder commands are rejected with RESTAURANT_CLOSED."
          }
        },
        {
          "name": "Rename and reopen restaurant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('renamed and OPEN', () => {",
                  "    pm.expect(body.name).to.eql('Pasta Place Downtown');",
                  "    pm.expect(body.status).to.eql('OPEN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{restaurantUrl}}/restaurants/{{restaurantId}}",
              "host": [
                "{{restaurantUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pasta Place Downtown\",\n  \"status\": \"OPEN\"\n}"
            }
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('version 1, available', () => {",
                  "    pm.expect(body.version).to.eql(1);",
                  "    pm.expect(body.available).to.eql(true);",
                  "    pm.expect(body.restaurantId).to.eql(pm.collectionVariables.get('restaurantId'));",
                  "});",
                  "pm.collectionVariables.set('productId', body.productId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{restaurantUrl}}/restaurants/{{restaurantId}}/products",
              "host": [
                "{{restaurantUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Spaghetti Carbonara\",\n  \"priceMinor\": 1450,\n  \"available\": true\n}"
            },
            "description": "Adds a product ($14.50) and saves `productId`. Publishes ProductChanged v1."
          }
        },
        {
          "name": "Change product price",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('price updated, version 2', () => {",
                  "    pm.expect(body.priceMinor).to.eql(1595);",
                  "    pm.expect(body.version).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{restaurantUrl}}/restaurants/{{restaurantId}}/products/{{productId}}",
              "host": [
                "{{restaurantUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}",
                "products",
                "{{productId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priceMinor\": 1595\n}"
            },
            "description": "Each update bumps `version` and publishes ProductChanged, so consumers can ignore stale events."
          }
        },
        {
          "name": "Mark product unavailable",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('unavailable, version 3', () => {",
                  "    pm.expect(body.available).to.eql(false);",
                  "    pm.expect(body.version).to.eql(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{restaurantUrl}}/restaurants/{{restaurantId}}/products/{{productId}}",
              "host": [
                "{{restaurantUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}",
                "products",
                "{{productId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": false\n}"
            },
            "description": "Orders containing this product are now rejected with PRODUCT_UNAVAILABLE."
          }
        },
        {
          "name": "Mark product available again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('available, version 4', () => pm.expect(pm.response.json().version).to.eql(4));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{restaurantUrl}}/restaurants/{{restaurantId}}/products/{{productId}}",
              "host": [
                "{{restaurantUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}",
                "products",
                "{{productId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": true\n}"
            }
          }
        },
