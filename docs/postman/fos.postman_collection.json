                  }
                ],
                "url": {
                  "raw": "{{paymentUrl}}/accounts/does-not-exist/credit",
                  "host": [
                    "{{paymentUrl}}"
                  ],
                  "path": [
                    "accounts",
                    "does-not-exist",
                    "credit"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amountMinor\": 100,\n  \"referenceId\": \"{{$guid}}\"\n}"
                }
              }
            },
            {
              "name": "Create account with empty name → 400",
              "event": [
                {
                  "listen": "test",
