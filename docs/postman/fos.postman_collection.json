{
  "info": {
    "name": "FOS – Food Ordering APIs",
    "description": "HTTP APIs of the deployed FOS services (us-east-2). Run with the Collection Runner, or request by request from the top: create requests save `accountId`, `restaurantId` and `productId` for the ones after them.\n\nAmounts are integer minor units (cents): 1450 = $14.50.\n\nThe URL variables come from each stack's `ApiUrl` output and change if a stack is destroyed and redeployed:\n`aws cloudformation describe-stacks --stack-name FosPayment --region us-east-2 --query \"Stacks[0].Outputs\"`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "paymentUrl",
      "value": "https://jqq85fsgqd.execute-api.us-east-2.amazonaws.com"
    },
    {
      "key": "restaurantUrl",
      "value": "https://ov5aeaff1b.execute-api.us-east-2.amazonaws.com"
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "referenceId",
      "value": ""
    },
    {
      "key": "creditAmount",
      "value": "5000"
    },
    {
      "key": "restaurantId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Payment",
      "description": "FosPayment HTTP API. Amounts are integer minor units (cents).",
      "item": [
        {
          "name": "Create account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('ACTIVE, zero USD balance', () => {",
                  "    pm.expect(body.status).to.eql('ACTIVE');",
                  "    pm.expect(body.balanceMinor).to.eql(0);",
                  "    pm.expect(body.currency).to.eql('USD');",
                  "});",
                  "pm.collectionVariables.set('accountId', body.accountId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentUrl}}/accounts",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "accounts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\"\n}"
            },
            "description": "Creates an ACTIVE USD account with balance 0 and saves `accountId`."
          }
        },
        {
          "name": "Get account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns the saved account', () => pm.expect(pm.response.json().accountId).to.eql(pm.collectionVariables.get('accountId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{paymentUrl}}/accounts/{{accountId}}",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}"
              ]
            }
          }
        },
        {
          "name": "Credit account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh referenceId per run. The duplicate request below reuses it.",
                  "pm.collectionVariables.set('referenceId', 'topup-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('applied, with a ledger entry', () => {",
                  "    pm.expect(body.duplicate).to.eql(false);",
                  "    pm.expect(body.entryId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentUrl}}/accounts/{{accountId}}/credit",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}",
                "credit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountMinor\": {{creditAmount}},\n  \"referenceId\": \"{{referenceId}}\"\n}"
            },
            "description": "Tops up the account. `referenceId` makes retries safe: each reference is applied once."
          }
        },
        {
          "name": "Credit account (duplicate referenceId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('flagged as duplicate', () => pm.expect(pm.response.json().duplicate).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentUrl}}/accounts/{{accountId}}/credit",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}",
                "credit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountMinor\": {{creditAmount}},\n  \"referenceId\": \"{{referenceId}}\"\n}"
            },
            "description": "Replays the previous top-up. Expect `duplicate: true` and no balance change."
          }
        },
        {
          "name": "Get account (balance after credit)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('credited exactly once', () => pm.expect(pm.response.json().balanceMinor).to.eql(Number(pm.collectionVariables.get('creditAmount'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{paymentUrl}}/accounts/{{accountId}}",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}"
              ]
            }
          }
        },
        {
          "name": "Get ledger",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('one CREDIT entry', () => pm.expect(pm.response.json().entries.filter(e => e.type === 'CREDIT')).to.have.lengthOf(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{paymentUrl}}/accounts/{{accountId}}/ledger",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}",
                "ledger"
              ]
            },
            "description": "Up to 50 ledger entries, newest first."
          }
        },
        {
          "name": "Errors",
          "item": [
            {
              "name": "Get unknown account → 404",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
