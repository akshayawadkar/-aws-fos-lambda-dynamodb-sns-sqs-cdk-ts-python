                }
              }
            },
            {
              "name": "Credit negative amount → 400",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{paymentUrl}}/accounts/{{accountId}}/credit",
                  "host": [
