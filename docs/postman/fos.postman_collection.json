                  "raw": "{{paymentUrl}}/accounts/does-not-exist",
                  "host": [
                    "{{paymentUrl}}"
                  ],
                  "path": [
                    "accounts",
                    "does-not-exist"
                  ]
                }
              }
            },
            {
              "name": "Credit unknown account → 404",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
